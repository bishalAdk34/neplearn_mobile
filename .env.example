# Google OAuth - https://console.cloud.google.com/apis/credentials
# Dev builds (package: com.neplearn.app.dev)
GOOGLE_CLIENT_ID_DEV=your_dev_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID_DEV=your_dev_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID_DEV=your_dev_ios_client_id.apps.googleusercontent.com

# Production builds (package: com.neplearn.app)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Supabase - https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# AI keys do NOT go here (anything in .env ships inside the app).
# Set the Groq key as a Supabase Edge Function secret instead:
#   supabase secrets set GROQ_API_KEY=gsk_...
